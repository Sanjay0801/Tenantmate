# ─────────────────────────────────────────────
#  TenantMate — environment variables template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# LLM API key (Anthropic)
# Get yours at: https://console.anthropic.com/
# Set a spending cap on your account before use!
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use for answering questions
# Use the cheap/fast model during development
LLM_MODEL=claude-haiku-4-5-20251001

# ─── Embedding model (runs locally, no API key needed) ───
# Downloaded automatically on first run via sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Database (matches docker-compose.yml defaults) ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tenantmate
DB_USER=tenantmate
DB_PASSWORD=tenantmate

# ─── Observability (fill in Week 4 when you set up Langfuse) ───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
